{
  "Serilog": {
    "Using": [],
    "MinimumLevel": {

      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }

    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithProcessId", "WithThreadId" ],
    "WriteTo": [
      { "Name": "Console" },      
      {
        "Name": "File",
        "Args": {          
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ]
  }
}
